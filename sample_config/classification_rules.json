{
  "schema_version": "1.0",
  "rules": [
    {
      "id": "transfer_to_tax_reserve",
      "priority": 10,
      "active": true,
      "match": {
        "description_contains_all": [
          "online transfer to tax reserve",
          "tax reserve transfer"
        ],
        "direction": "outflow",
        "bank_account": "Operating Checking",
        "currency": "USD"
      },
      "outcome": {
        "transaction_type": "transfer",
        "account_number": "1010",
        "account_name": "Tax Reserve",
        "confidence_score": "1.000",
        "explanation": "The description explicitly identifies an internal transfer from Operating Checking to Tax Reserve.",
        "review_required": false
      }
    },
    {
      "id": "transfer_from_operating",
      "priority": 20,
      "active": true,
      "match": {
        "description_contains_all": [
          "online transfer from operating",
          "tax reserve transfer"
        ],
        "direction": "inflow",
        "bank_account": "Tax Reserve",
        "currency": "USD"
      },
      "outcome": {
        "transaction_type": "transfer",
        "account_number": "1000",
        "account_name": "Operating Checking",
        "confidence_score": "1.000",
        "explanation": "The description explicitly identifies the Tax Reserve side of an internal transfer from Operating Checking.",
        "review_required": false
      }
    },
